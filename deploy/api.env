# KakologInfo API 設定（仕様書16.1: ドメインは必ずここで管理。コード直書き禁止）
# 配置先: /etc/kakosearch/api.env
KAKO_DB_PATH=/opt/kakosearch/db/kakolog.db
KAKO_MANTICORE_ADDR=127.0.0.1:9306
KAKO_LISTEN=127.0.0.1:8080
# 板URL対応表に無い板のフォールバック先。5ch のドメインが再移転したら
# この行と board-urls.json を差し替えて systemctl restart kakosearch-api するだけでよい
KAKO_5CH_BASE=https://kako.5ch.io
KAKO_BOARD_URLS=/opt/kakosearch/db/board-urls.json
KAKO_HAS_OLD=true
# 正確な件数・拡張ページネーション（依頼者承認の12.1逸脱）。
# 性能問題が出たら false にすると仕様書どおり（概算・20頁）に戻る
KAKO_EXACT_COUNT=true
# 正確に数える上限。0 または未設定 = 無制限（完全に正確）。
# 100000 にすると 10万件以下は正確なまま、超過分だけ概算になり、
# 最悪ケース（1文字+板指定）が 1,425ms → 185ms になる（docs/benchmark.md の追試）。
# KAKO_EXACT_COUNT_LIMIT=100000
